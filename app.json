{
  "expo": {
    "name": "AR Starter",
    "slug": "augmented-reality-ar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "AR Starter uses the camera to scan QR codes and display augmented reality content."
        }
      ],
      [
        "@reactvision/react-viro",
        {
          "android": {
            "xRMode": ["AR"]
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "AR Starter uses the camera to place augmented reality content in your space."
      }
    },
    "android": {
      "package": "com.marcl.arstarter",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
